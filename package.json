{
  "name": "benchmarking-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "check": "prettier --check . && npm run build && npm test",
    "prepare:engines": "node scripts/prepare-engines.mjs",
    "prebuild": "npm run prepare:engines",
    "predev": "npm run prepare:engines"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "@electric-sql/pglite": "0.5.13",
    "wabt": "1.0.39"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
